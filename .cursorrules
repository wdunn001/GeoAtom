{
  "bestPractices": {
    "m5AtomEcho": [
      "When working with M5Atom Echo, always initialize M5Unified with disabled serial using: auto cfg = M5.config(); cfg.serial_baudrate = 0; M5.begin(cfg);",
      "Use these build flags in platformio.ini for M5Atom Echo: -D ARDUINO_USB_MODE=1 -D ARDUINO_USB_CDC_ON_BOOT=1 -D DISABLE_SERIAL=1 -D DISABLE_SERIALEVENT=1",
    ],
    "platformIO": [
      "Always pin library versions in platformio.ini: lib_deps = m5stack/M5Unified@^0.2.5",
      "Use build_flags for configuration rather than modifying library code",
      "Create separate environments like [env:debug] and [env:release] for different build targets",
      "Use a consistent folder structure: src/ for app code, lib/ for project libraries, .cursor/ for configuration"
    ],
    "cppEmbedded": [
      "Prefer stack allocation over heap when possible for embedded systems",
      "Avoid blocking calls like delay() in production code. Use millis() for non-blocking timing",
      "Check return values from functions that can fail: if (!sensor.begin()) { /* Handle error */ }",
      "Define pin numbers as constants: #define GPS_RX 22",
      "Use enum class for type safety: enum class DeviceState { INITIALIZING, RUNNING, ERROR }"
    ],
    "gpsDevelopment": [
      "Always validate GPS data before using: if (gps.location.isValid() && gps.time.isValid()) { /* Use GPS data */ }",
      "Process GPS data as it becomes available to avoid missing points",
      "Handle GPS data absence gracefully with appropriate user feedback"
    ],
    "cursorIDE": [
      "Use the keyboard shortcut Cmd+K (or Ctrl+K) to get AI assistance with code",
      "Use @ruleName to reference other Cursor rules",
      "Use 'New Cursor Rule' command to create new rules",
      "For complex edits, provide clear context by explaining purpose, behavior and constraints"
    ],
    "linterLagDetection": [
      "Verify code correctness: Check documentation to confirm API usage is correct before assuming linter errors are false positives",
      "If code builds but the linter shows errors for code you've changed repeatedly, suspect a linter refresh issue",
      "Try forcing linter refresh: Save all files, close/reopen file, restart language server, or add/fix a temporary syntax error",
      "For persistent linter errors with correct code, document the issue in comments and proceed if compilation succeeds",
      "Make significant changes to problematic lines (rearrange, rename) to break cache dependencies if linter remains stuck"
    ],
    "workflow": [
      "Build the project after making code changes before attempting to fix newly appeared linter errors, as they might be due to build state or cache issues."
    ]
  }
} 