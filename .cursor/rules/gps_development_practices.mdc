```cpp
// Simple sensor fusion for GPS and IMU
void fuseSensorData(float gpsLat, float gpsLng, float imuHeading, float imuAcceleration) {
  static float fusedLat = 0, fusedLng = 0, fusedHeading = 0;
  static uint32_t lastGpsUpdate = 0;
  uint32_t currentTime = millis();
  
  // GPS data is valid, update position with some weight from IMU data
  if (gps.location.isValid()) {
    lastGpsUpdate = currentTime;
    // Apply complementary filter
    const float GPS_WEIGHT = 0.7;
    fusedLat = gpsLat * GPS_WEIGHT + fusedLat * (1 - GPS_WEIGHT);
    fusedLng = gpsLng * GPS_WEIGHT + fusedLng * (1 - GPS_WEIGHT);
    
    // Update heading primarily from GPS when moving
    if (gps.speed.kmph() > 3.0) {
      fusedHeading = gps.course.deg() * 0.8 + imuHeading * 0.2;
    } else {
      // At low speeds, trust IMU more for heading
      fusedHeading = gps.course.deg() * 0.2 + imuHeading * 0.8;
    }
  } else {
    // No GPS fix, use dead reckoning based on IMU
    // Only apply for a reasonable time period
